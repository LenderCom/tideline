{
  "name": "@bydawn/tideline",
  "version": "0.1.0",
  "description": "Lossless Markdown ⇄ Tiptap 3, with a 3-way merge.",
  "license": "Apache-2.0",
  "author": "Lender Software Solutions LLC",
  "homepage": "https://github.com/LenderCom/tideline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LenderCom/tideline.git"
  },
  "bugs": {
    "url": "https://github.com/LenderCom/tideline/issues"
  },
  "keywords": [
    "bydawn",
    "tiptap",
    "prosemirror",
    "markdown",
    "codec",
    "round-trip",
    "merge",
    "yjs"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mention": {
      "types": "./dist/mention.d.ts",
      "default": "./dist/mention.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4"
  },
  "peerDependenciesMeta": {
    "@tiptap/extension-mention": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code": "3.31.4",
    "@tiptap/extension-code-block": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/y-tiptap": "3.0.10",
    "@types/node": "^24.0.0",
    "fast-check": "4.10.2",
    "happy-dom": "^20.10.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
